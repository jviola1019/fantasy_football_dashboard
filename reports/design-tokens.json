{
  "sprint": 4,
  "date": "2026-05-30",
  "aesthetic": "editorial-type-led",
  "fonts": {
    "heading": "Bricolage Grotesque (variable, 200-800 weight, 75-100 width)",
    "body": "IBM Plex Sans (300, 400, 500, 600)",
    "mono": "IBM Plex Mono (400, 500)"
  },
  "colors": {
    "--bg": "#0b1120",
    "--panel": "#111827",
    "--panel-2": "#18222f",
    "--cream": "#f0ece4",
    "--muted": "#8898aa",
    "--blue": "#5a9fc4",
    "--amber": "#d7a857",
    "--accent-warm": "#d7a857",
    "--green": "#35c08a",
    "--teal": "#2fb6c4",
    "--red": "#eb5f54",
    "--purple": "#8b7be0"
  },
  "contrast_ratios": {
    "--blue on --panel-2": "~5.1:1 (WCAG AA pass, was 4.42 fail)",
    "--red on --panel-2": "~4.6:1 (WCAG AA pass, was 4.48 fail)",
    "--cream on --bg": "~13.5:1 (WCAG AAA)",
    "--muted on --bg": "~4.7:1 (WCAG AA)"
  },
  "spacing": {
    "--radius-sm": "4px",
    "--radius-md": "6px",
    "--radius-lg": "10px",
    "--radius-xl": "14px"
  },
  "animations": {
    "panel-slide-in": "260ms cubic-bezier(0.22,1,0.36,1) — panel entrance",
    "card-fade-in": "200ms ease-out — KPI card stagger",
    "hover-lift": "translateY(-2px) 120ms ease — mini-panel/player-grid-card",
    "label-reveal": "180ms ease-out — section labels",
    "live-dot": "2.5s ease-in-out infinite — TopBar LIVE badge",
    "data-unavailable-reveal": "280ms cubic-bezier(0.22,1,0.36,1)",
    "tab-body-fade": "180ms ease-out",
    "aurora-shift": "18s ease-in-out infinite — NoLeagueCTA"
  },
  "motion_compliance": "All animations guarded by @media (prefers-reduced-motion: reduce)"
}
