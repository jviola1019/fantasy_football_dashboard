# Auth.js
AUTH_SECRET=replace_me_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Database
# Local dev: SQLite file path. Prefix with file: to be explicit.
# Production: a Postgres URL via a Vercel Marketplace Postgres provider (Neon, etc.).
DATABASE_URL=file:.data/rae.sqlite

# Credential encryption key — base64-encoded 32 bytes.
# Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# Optional: enable clearly labeled dev/test fixtures in the dashboard.
RAE_ALLOW_FIXTURES=false

# Optional: have the homepage attempt a live Sleeper-players fetch on every
# request. Off by default because the catalog is ~19 MB. Per-user live data is
# served from /api/leagues/[id]/refresh after sign-in regardless of this flag.
RAE_ENABLE_LIVE_HOMEPAGE=false

# Required only to call POST /api/admin/init-db (one-time Postgres bootstrap).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_INIT_TOKEN=

# Required for Vercel cron jobs. Vercel sets `Authorization: Bearer $CRON_SECRET`
# on requests it triggers, so the cron route can verify it really is Vercel.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Optional: live API round-trip tests (skipped by default in vitest).
RAE_LIVE_TESTS=0
RAE_LIVE_SLEEPER_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
