node_modules/
.next/
out/
coverage/
.env*.local
.env
*.tsbuildinfo
.DS_Store

# Local dev/test databases and the cached Sleeper player catalog.
.data/

# Playwright run output.
test-results/
playwright-report/

# Locally generated binary audit artifacts are not reviewable in text-only GitHub diffs.
artifacts/screenshots/*.png
artifacts/screenshots/*.jpg
artifacts/screenshots/*.jpeg
artifacts/screenshots/*.webp

# Lighthouse CI artifacts
.lighthouseci/
reports/lighthouse/

# Audit 2026-08-20 §19: loose per-league holdout files are the working set.
# The reproducible artifact committed to the repo is holdout-data.jsonl.gz.
reports/2026-08-20/holdout-data/

# Protocol 4 working set; the reproducible artifact is nflverse-usage.json.gz
reports/2026-08-20/nflverse/

# Generated by `npm run audit:ui` — machine-specific base URL, regenerate rather than track.
audit-ui.json

# Current-build viewport captures, regenerated by every `npm run e2e` run.
# Committing them would leave the tree dirty after every suite and bury real
# changes in binary noise. A dated report that needs a frozen capture copies the
# file into its own directory deliberately — see reports/screens/README.md.
reports/screens/*.png

# Regenerable gate output must not be committed at the reports/ root. Ten such
# files sat there from a single 2026-05-30 run until 2026-09-02, three months
# stale, unreferenced, and actively misleading — build.txt reported a Next
# version the repo no longer used. If a gate's output is worth keeping it goes
# in a DATED report that interprets it. See reports/README.md.
reports/*.txt
reports/*.json
